#!/usr/bin/env ruby

require "json"

CASK_RELEASE_BLOCK = Regexp.new(
  '^  version "(?<current_version>\d+\.\d+\.\d+)"\n' \
    '  sha256 arm:   "(?<current_arm_sha>[0-9a-f]{64})",\n' \
    '         intel: "(?<current_intel_sha>[0-9a-f]{64})"$',
)
USAGE = "Usage: script/update-cask RELEASE_JSON [CASK]\n" \
        "       script/update-cask --current-tag [CASK]"

def read_cask_release(cask_path)
  cask = File.read(cask_path)
  matches = cask.scan(CASK_RELEASE_BLOCK)
  abort "Could not find the Rufin release block" unless matches.length == 1

  [cask, *matches.fetch(0)]
end

if ARGV.first == "--current-tag"
  abort USAGE unless (1..2).cover?(ARGV.length)

  _, current_version = read_cask_release(ARGV.fetch(1, "Casks/rufin.rb"))
  puts "v#{current_version}"
  exit
end

abort USAGE unless (1..2).cover?(ARGV.length)

release_path = ARGV.fetch(0)
cask_path = ARGV.fetch(1, "Casks/rufin.rb")
release = JSON.parse(File.read(release_path))

abort "The Rufin release is a draft" if release.fetch("draft")
abort "The Rufin release is a prerelease" if release.fetch("prerelease")

tag = release.fetch("tag_name")
version_match = /\Av(?<version>\d+\.\d+\.\d+)\z/.match(tag)
abort "Unexpected Rufin release tag: #{tag}" unless version_match

version = version_match[:version]
assets = release.fetch("assets")

digest_for = lambda do |name|
  matches = assets.select { |asset| asset.fetch("name") == name }
  abort "Expected one #{name} asset, found #{matches.length}" unless matches.length == 1

  asset = matches.fetch(0)
  expected_url = "https://github.com/screwys/Rufin/releases/download/#{tag}/#{name}"
  actual_url = asset.fetch("browser_download_url")
  abort "Unexpected URL for #{name}: #{actual_url}" unless actual_url == expected_url

  digest = asset.fetch("digest")
  digest_match = /\Asha256:(?<sha>[0-9a-f]{64})\z/.match(digest)
  abort "Unexpected digest for #{name}: #{digest}" unless digest_match

  digest_match[:sha]
end

arm_sha = digest_for.call("Rufin-macos-arm64.dmg")
intel_sha = digest_for.call("Rufin-macos-x86_64.dmg")

current, current_version, current_arm_sha, current_intel_sha = read_cask_release(cask_path)
version_numbers = version.split(".").map(&:to_i)
current_version_numbers = current_version.split(".").map(&:to_i)
version_comparison = version_numbers <=> current_version_numbers
if version_comparison == -1
  abort "Refusing to downgrade Rufin from #{current_version} to #{version}"
end
if version_comparison.zero? && (arm_sha != current_arm_sha || intel_sha != current_intel_sha)
  abort "Refusing to change Rufin #{version} asset digests"
end

updated = current.sub(
  CASK_RELEASE_BLOCK,
  "  version \"#{version}\"\n" \
    "  sha256 arm:   \"#{arm_sha}\",\n" \
    "         intel: \"#{intel_sha}\"",
)
File.write(cask_path, updated) unless updated == current

puts version
